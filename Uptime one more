#!/bin/bash

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

# Check whether server list file is provided
if [ -z "$1" ]; then
    echo "Usage: $0 <server_list_file>"
    echo "Example: $0 /root/servers.txt"
    exit 1
fi

SERVER_FILE="$1"

# Check whether file exists
if [ ! -f "$SERVER_FILE" ]; then
    echo "ERROR: Server list file '$SERVER_FILE' not found."
    exit 1
fi

for server in $(cat "$SERVER_FILE")
do
    uptime_seconds=$(ssh -o ConnectTimeout=5 "$server" \
        "awk '{print int(\$1)}' /proc/uptime" 2>/dev/null)

    if [ -z "$uptime_seconds" ]; then
        echo -e "$server : SSH connection failed"
        continue
    fi

    uptime_days=$((uptime_seconds / 86400))

    if [ "$uptime_seconds" -lt 86400 ]; then

        echo -e "${RED}$server : Uptime = ${uptime_days} day(s) - BELOW 1 DAY${NC}"

    elif [ "$uptime_seconds" -lt 604800 ]; then

        echo -e "${YELLOW}$server : Uptime = ${uptime_days} day(s) - BETWEEN 1 AND 7 DAYS${NC}"

    else

        echo -e "${GREEN}$server : Uptime = ${uptime_days} day(s) - ABOVE 7 DAYS${NC}"

    fi
done
