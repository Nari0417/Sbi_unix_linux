logstash 
---------


input {
  redis {
    id => "redis-rlms"
    host => "127.0.0.1"
    port => 6379
    password => "rlms123"
    key => "rlms"
    data_type => "list"
    type => "syslog"
  }

  redis {
    id => "redis-d1rlmsapiapp1"
    host => "127.0.0.1"
    port => 6379
    password => "rlms123"
    key => "d1rlmsapiapp1"
    data_type => "list"
    type => "syslog"
  }
}

filter {
  if [type] == "syslog" {
    grok {
      match => {
        "message" => "%{SYSLOGTIMESTAMP:syslog_timestamp} %{SYSLOGHOST:syslog_hostname} %{DATA:syslog_program}(?:\[%{POSINT:syslog_pid}\])?: %{GREEDYDATA:syslog_message}"
      }

      add_field => {
        "received_at" => "%{@timestamp}"
        "received_from" => "%{host}"
      }
    }

    syslog_pri {}

    date {
      match => [
        "syslog_timestamp",
        "MMM d HH:mm:ss",
        "MMM dd HH:mm:ss"
      ]
    }
  }
}

output {
  elasticsearch {
    id => "elasticsearch-rlms"
    hosts => ["https://elk.rlms.sbi:9200"]
    user => "elastic"
    password => "rlms123"

    ssl_enabled => true
    ssl_certificate_authorities => ["/etc/logstash/conf.d/ca.crt"]

    sniffing => false
    manage_template => false

    index => "rlms-logs-%{+yyyy.MM.dd}"
  }
}




